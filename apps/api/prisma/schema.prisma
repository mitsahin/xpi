generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MCQ
  FILL_BLANK
  TRANSLATE
  LISTEN
  MATCH
}

enum LessonSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SrsCardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String
  displayName String
  timezone    String   @default("UTC")
  xp          Int      @default(0)
  level       Int      @default(1)
  hearts      Int      @default(5)
  dailyXpGoal Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  streak          Streak?
  progress        UserProgress[]
  sessions        LessonSession[]
  srsCards        SrsCard[]
  xpEvents        XpEvent[]
  dailyActivities DailyActivity[]
  refreshTokens   RefreshToken[]
}

/// Opaque refresh tokens (store hash only). Designed for body or httpOnly cookie delivery.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  language    String   @default("es")
  lessons     Lesson[]
}

model Lesson {
  id               String   @id @default(cuid())
  courseId         String
  slug             String
  title            String
  description      String
  unitOrder        Int
  lessonOrder      Int
  xpReward         Int      @default(20)
  estimatedMinutes Int      @default(5)

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  progress  UserProgress[]
  sessions  LessonSession[]

  @@unique([courseId, slug])
  @@index([courseId, unitOrder, lessonOrder])
}

model Question {
  id          String       @id @default(cuid())
  lessonId    String
  type        QuestionType
  prompt      String
  optionsJson Json?
  answerJson  Json
  hint        String?
  explanation String?
  orderIndex  Int
  srsEligible Boolean      @default(true)

  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  srsCards SrsCard[]

  @@index([lessonId, orderIndex])
}

model UserProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  completed       Boolean   @default(false)
  stars           Int       @default(0)
  bestScore       Int       @default(0)
  timesCompleted  Int       @default(0)
  lastCompletedAt DateTime?
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonSession {
  id              String              @id @default(cuid())
  userId          String
  lessonId        String
  status          LessonSessionStatus @default(IN_PROGRESS)
  currentIndex    Int                 @default(0)
  heartsRemaining Int                 @default(5)
  correctCount    Int                 @default(0)
  incorrectCount  Int                 @default(0)
  questionIds     String[]
  answersJson     Json                @default("{}")
  startedAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?
  xpAwarded       Int                 @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId, status])
}

model Streak {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActiveDate   String?
  /// Banked streak freezes (Phase 2). Consumed when bridging a 1-day gap.
  freezesAvailable Int      @default(1)
  freezesUsed      Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyActivity {
  id               String  @id @default(cuid())
  userId           String
  date             String
  xpEarned         Int     @default(0)
  lessonsCompleted Int     @default(0)
  reviewsCompleted Int     @default(0)
  goalMet          Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model SrsCard {
  id             String       @id @default(cuid())
  userId         String
  questionId     String
  easeFactor     Float        @default(2.5)
  intervalDays   Int          @default(0)
  repetitions    Int          @default(0)
  lapses         Int          @default(0)
  state          SrsCardState @default(NEW)
  dueAt          DateTime     @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
}
