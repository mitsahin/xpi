DATABASE_URL="postgresql://walkytalky:walkytalky@localhost:5432/walkytalky?schema=public"
JWT_SECRET="change-me-in-production"
# Short-lived access JWT (jsonwebtoken expiresIn). Pair with refresh tokens.
JWT_EXPIRES_IN="15m"
# Opaque refresh token lifetime (stored hashed in DB).
JWT_REFRESH_EXPIRES_IN="30d"
# When true, also Set-Cookie httpOnly `walky-talky:refresh` on login/refresh (cookie-ready).
AUTH_SET_COOKIE="false"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:8081"
NODE_ENV=development
JSON_BODY_LIMIT="32kb"
